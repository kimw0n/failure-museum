#!/bin/sh
# 진행과정 문서(docs/PROGRESS.md, docs/진행과정.docx)가 코드보다 오래됐으면 push를 막는다.
# 활성화: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 0
command -v python3 >/dev/null 2>&1 || exit 0
if ! python3 docs/build_progress.py --check; then
  echo ""
  echo "✋ push 전에 진행과정 문서를 갱신하세요:"
  echo "   1) docs/PROGRESS.md 에 이번 변경 내용 추가 (화면이 바뀌었으면 docs/img/ 에 스크린샷)"
  echo "   2) python3 docs/build_progress.py     # 커밋 기록 + docs/진행과정.docx 다시 만들기"
  echo "   3) git add docs && git commit -m \"docs: 진행과정 갱신\" && git push"
  echo "   (급할 때만: git push --no-verify)"
  exit 1
fi
exit 0
